    "@types/nodemailer": "^6.4.14",
    "@types/superagent": "^8.1.6",
    "@types/uuid": "^3.4.10",
    "chai": "^4.4.1",
    "chai-http": "^4.4.0",
    "mocha": "^10.4.0",
